// =============================================
// 阿里百炼 FunAsr 插件元数据（宿主用宽松 JSON 解析，支持注释）
// =============================================

{
  // 插件唯一标识（沿用原 DEX 插件 id，覆盖旧实现）
  "id": "com.kingzcheung.xime.plugin.funasr_asr",

  // 插件名称与描述（语音转文本服务商列表展示）
  "name": "阿里百炼 FunAsr",
  "icon": "🎤",
  "description": "阿里百炼 FunAsr 在线语音识别，使用阿里云控制台获取的 API Key，可参考 快速入门（https://www.aliyun.com/product/bailian）",

  // 插件版本（字符串）
  "version": "3.1.0",

  // 插件分类：speech 语音识别（单选激活）
  "type": "speech",
  "activation": "single",

  // 入口脚本（TS 源码由 xipm 编译为 IIFE 单文件）
  "entry": "main.js",

  // 目标平台（缺省视为 ["android"]；可选 android/ios/windows/macos/linux）
  "platforms": ["android"],

  // 宿主最低版本要求
  "minHostVersion": "3.0.0",

  // 能力声明
  "capabilities": {
    "speech": {
      "inputMode": "streaming",        // 实时流式识别
      "supportsPartialResults": true
    }
  },

  // 网络访问声明：插件需要连接的域名（宿主据此校验白名单/用户授权）
  "network": {
    "hosts": [
      "dashscope.aliyuncs.com"
    ]
  }
}
